# Native observation uses the consumer-owned ProviderConfig. Credentials never
# pass through this composition, and observing/deleting this resource cannot
# create or delete the Helm-installed Zitadel instance.
{{- if $state.instanceDiscovery.enabled }}
{{- $pc := $state.instanceDiscovery.providerConfigRef | default dict }}
{{- if not (and $pc.name $pc.kind) }}{{- fail "instanceDiscovery.providerConfigRef is required when enabled" }}{{- end }}
---
apiVersion: instance.zitadel.m.crossplane.io/v1alpha1
kind: Instance
metadata:
  name: {{ $state.name }}-instance
  annotations:
    {{ setResourceNameAnnotation "instance" }}
    gotemplating.fn.crossplane.io/ready: {{ ternary "True" "False" (ne $state.status.instanceId "") | quote }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: [Observe]
  providerConfigRef:
    name: {{ $pc.name }}
    kind: {{ $pc.kind }}
{{- if and $state.observed.helmRelease.ready (ne $state.status.instanceId "") }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-instance-before-zitadel
  annotations:
    {{ setResourceNameAnnotation "usage-instance-zitadel" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef: {name: {{ $state.name }}-zitadel}
  by:
    apiVersion: instance.zitadel.m.crossplane.io/v1alpha1
    kind: Instance
    resourceRef: {name: {{ $state.name }}-instance}
{{- end }}
{{- end }}
